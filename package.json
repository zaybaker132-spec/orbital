{
  "name": "orbital",
  "version": "0.2.0",
  "description": "Orbital \u2014 personal and business intelligence environment",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,white \"tsx watch server/main.ts\" \"vite\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "migrate": "tsx server/db/migrate-cli.ts",
    "test": "tsx --test server/engines/research.test.ts server/api.test.ts server/ai.test.ts server/business.test.ts",
    "build:server": "node scripts/build-server.mjs",
    "desktop": "npm run build && npm run build:server && electron .",
    "desktop:pack": "npm run build && npm run build:server && electron-builder --dir",
    "desktop:dist": "npm run build && npm run build:server && electron-builder"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "cookie-parser": "^1.4.7",
    "electron-updater": "^6.8.11",
    "express": "^4.22.3",
    "multer": "^1.4.4",
    "pg": "^8.23.1",
    "unpdf": "^1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/fiber": "^8.17.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "d3-force": "^3.0.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.74.0",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.19",
    "three": "^0.169.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "zustand": "^4.5.7"
  },
  "type": "module",
  "private": true,
  "main": "desktop/main.cjs",
  "productName": "Orbital",
  "author": {
    "name": "Orbital"
  },
  "homepage": "https://github.com/"
}

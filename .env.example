# ── Server ──────────────────────────────────────────────────────────────
PORT=8787
# Leave empty to use embedded PostgreSQL (PGlite + pgvector) stored in ORBITAL_DATA_DIR.
# Set to a real PostgreSQL 15+ with the pgvector extension available for production.
DATABASE_URL=
ORBITAL_DATA_DIR=.orbital-data
ORBITAL_ALLOW_SIGNUP=true
SESSION_TTL_DAYS=30
# Defaults to true when NODE_ENV=production. Requires HTTPS.
COOKIE_SECURE=
MAX_UPLOAD_MB=25

# ── AI provider (server-side only; never exposed to the browser) ────────
# anthropic | openai | none — auto-detected from the keys below when unset.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback (Anthropic beta). Set to off to disable.
ANTHROPIC_FALLBACKS=on

# Any OpenAI-compatible chat endpoint (OpenAI, Ollama, LM Studio, vLLM…). No web search.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Voice (speech-to-text) ───────────────────────────────────────────────
# Used where the browser has no speech recognition (desktop app, Firefox). Any OpenAI-compatible
# /audio/transcriptions endpoint (OpenAI Whisper, Groq, local whisper.cpp / faster-whisper).
# Defaults to OPENAI_BASE_URL / OPENAI_API_KEY when an OpenAI key is set.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# ── Embeddings (semantic retrieval) ──────────────────────────────────────
# local  = private, offline hashed lexical features (default)
# openai = any OpenAI-compatible /embeddings endpoint that supports `dimensions` (recommended)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=

# ── Research sources ─────────────────────────────────────────────────────
RESEARCH_WEB_SEARCH=true
RESEARCH_WIKIPEDIA=true
RESEARCH_OPENALEX=true
RESEARCH_MAX_SOURCES=4
# Wikimedia asks API clients to identify themselves; include a contact URL if you deploy publicly.
RESEARCH_USER_AGENT=
# Knowledge extraction reads long documents in ~6,000-character parts; this caps the parts per document.
EXTRACT_MAX_PARTS=150

# ── Business & deployment ────────────────────────────────────────────────
# Encrypts connector URLs/secrets at rest. 32+ characters. If unset, a random key is
# generated into ORBITAL_DATA_DIR/secret.key — back that file up with the database.
ORBITAL_SECRET_KEY=
# Public URL used in invite, password-reset and waitlist links (e.g. https://orbital.yourcompany.com).
# Required for emailed links on a hosted server: the request's Host header is never trusted for them.
ORBITAL_PUBLIC_URL=
# Where users download the desktop app (shown in Settings), e.g. your GitHub Releases page.
ORBITAL_DOWNLOAD_URL=
# Allow webhooks and the web clipper to reach private/loopback addresses (on-prem tools). Off by default to prevent SSRF.
ORBITAL_ALLOW_PRIVATE_WEBHOOKS=false
# How often the scheduler checks for due automations (ms).
AUTOMATION_TICK_MS=60000
# Accounts that can view and export the public waitlist (comma-separated emails).
ORBITAL_ADMIN_EMAILS=

# ── Meetings (video) ─────────────────────────────────────────────────────
MEETING_MAX_PARTICIPANTS=8
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN relay for strict networks (see docs/MEETINGS.md).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Production operations ────────────────────────────────────────────────
# Which proxies to trust for the client IP and https (rate limits, secure cookies, HSTS).
# "loopback" (default) for a local reverse proxy; 1 behind exactly one hosting proxy (Render, Fly, Heroku).
ORBITAL_TRUST_PROXY=loopback
# Redirect http to https and send HSTS. Defaults to on when NODE_ENV=production and ORBITAL_PUBLIC_URL is https.
ORBITAL_FORCE_HTTPS=
# Run background jobs and the automation scheduler in this process. With several web instances, set
# true on exactly one (jobs are claimed safely, but one runner keeps scheduling simple). Default true.
ORBITAL_RUN_JOBS=true
# json (default in production) or pretty. Secrets, cookies and passwords are scrubbed from every log line.
LOG_FORMAT=
# Optional: a Slack-compatible incoming webhook that receives server errors (rate-limited per message).
ORBITAL_ALERT_WEBHOOK=

# ── Email (Resend) ───────────────────────────────────────────────────────
# Password reset, waitlist confirmation and "you're in" emails. Without a key nothing is sent, and the
# app says so honestly (password reset is unavailable; admins are told to notify people themselves).
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. Orbital <hello@yourdomain.com>
ORBITAL_EMAIL_FROM=

# ── AI cost controls ─────────────────────────────────────────────────────
# Monthly token allowance per workspace (input + output + cache writes). 0 = unlimited.
ORBITAL_AI_MONTHLY_TOKENS=0
# Per-request timeout (ms) and retries for the Anthropic API.
ANTHROPIC_TIMEOUT_MS=600000
ANTHROPIC_MAX_RETRIES=2
# Override list prices used for cost estimates: AI_PRICE_<MODEL>="input,output,cacheRead" in $ per million tokens,
# e.g. AI_PRICE_CLAUDE_OPUS_5_5="4,20,0.2"

# ── Weather (sidebar) ────────────────────────────────────────────────────
# Open-Meteo: free, no key. Only the place someone chooses is sent (rounded coordinates). false = off.
ORBITAL_WEATHER=true
WEATHER_API_URL=https://api.open-meteo.com
WEATHER_GEOCODE_URL=https://geocoding-api.open-meteo.com

# ── Media library ────────────────────────────────────────────────────────
# Screenshots, screen/voice/camera recordings, meeting recordings and uploads, stored in the database.
MEDIA_MAX_MB=500
# Storage per workspace in MB (0 = no limit). On a small hosted database (e.g. Supabase's free 500 MB), keep this low.
MEDIA_QUOTA_MB=0
